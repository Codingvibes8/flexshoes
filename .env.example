# Neon Postgres (Drizzle ORM)
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk authentication
# Development keys: npx clerk@latest init --accountless
# Dashboard keys: https://dashboard.clerk.com/~/api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Stripe (test keys: https://dashboard.stripe.com/test/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Account id shown in the Stripe dashboard (acct_...)
STRIPE_ID=acct_your_account_id
# Lowercase ISO currency used for Checkout line items
STRIPE_CURRENCY=usd
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Public origin used for Checkout success/cancel URLs (optional in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
